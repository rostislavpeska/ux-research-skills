    {
      "id": "d2abc207-8e82-40b0-af91-021523109cd4",
      "name": "Eval State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3136,
        0
      ],
      "parameters": {
        "jsCode": "const f = $input.first().json;\nif (f.state === 'ACTIVE') return [{ json: { ready: true, file: f } }];\nif (f.state === 'FAILED') throw new Error('Gemini file processing FAILED: ' + JSON.stringify(f.error || {}));\nif ($runIndex >= 60) throw new Error(`Gemini file still ${f.state} after ~10 min`);\nreturn [{ json: { ready: false, state: f.state || 'unknown' } }];"
      }
    },
    {
      "id": "10c07e0e-6cd5-49c5-a282-e9a546f3fc21",
      "name": "Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        3360,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "2c1beeeb-4ccd-44e4-9f0b-8939f963cfe2",
              "leftValue": "={{ $json.ready }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f780ff02-a171-4116-9d3c-4dc4d73c4c92",
      "name": "Build Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3584,
        -96
      ],
      "parameters": {
        "jsCode": "const d = $('Decide').first().json;\nconst meta = $('Drive Metadata').first().json;\nconst f = $input.first().json.file;\nconst durMs = Number(meta.videoMediaMetadata && meta.videoMediaMetadata.durationMillis);\nreturn [{ json: {\n  interview_id: d.interview_id,\n  study_id: d.study_id,\n  participant_id: d.participant_id,\n  drive_file_id: d.drive_file_id,\n  drive_md5: meta.md5Checksum || null,\n  duration_s: Number.isFinite(durMs) ? durMs / 1000 : null,\n  gemini_file_uri: f.uri,\n  gemini_file_expires_at: f.expirationTime ? String(f.expirationTime).slice(0, 19).replace('T', ' ') : null,\n  status: 'ingested',\n} }];"
      }
    },

    {
      "parameters": {
        "jsCode": "// Read/write ONLY the ux_* research tables. Table ids are this harness's config.\nconst TABLES = {\n  ux_interviews: 'REPLACE_TABLE_ID_ux_interviews',\n  ux_runs: 'REPLACE_TABLE_ID_ux_runs',\n  ux_transcript: 'REPLACE_TABLE_ID_ux_transcript',\n};\nconst b = $('When Called').first().json.body || {};\nconst table_id = TABLES[b.table];\nif (!table_id) throw new Error(`table not allowed - use one of ${Object.keys(TABLES).join(', ')}`);\nif (b.op === 'read') {\n  return [{ json: { op: 'read', table: b.table, table_id, where: typeof b.where === 'string' ? b.where : '' } }];\n}\nif (b.op === 'write') {\n  if (!Array.isArray(b.rows) || !b.rows.length) throw new Error('write needs a non-empty rows array');\n  if (b.rows.length > 100) throw new Error('max 100 rows per call (NocoDB bulk limit) - send in chunks');\n  return [{ json: { op: 'write', table: b.table, table_id, rows: b.rows } }];\n}\nthrow new Error('op must be read or write');"
      },

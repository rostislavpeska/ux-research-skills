    {
      "parameters": {
        "jsCode": "// Count only rows NocoDB really stored (they come back with an Id). Never report a write that did not happen.\nconst items = $input.all();\nconst stored = items.filter(i => i.json && (i.json.Id !== undefined || i.json.id !== undefined) && !i.json.error);\nif (stored.length !== $('Validate').first().json.rows.length) {\n  throw new Error(`NocoDB stored ${stored.length} of ${$('Validate').first().json.rows.length} rows`);\n}\nreturn [{ json: { table: $('Validate').first().json.table, written: stored.length } }];"
      },

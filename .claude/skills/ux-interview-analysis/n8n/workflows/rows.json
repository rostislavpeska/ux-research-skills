      "parameters": {
        "jsCode": "const v = $('Validate').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length);\nreturn [{ json: { table: v.table, count: rows.length, rows } }];"
      },
